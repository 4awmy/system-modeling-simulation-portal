    "title": "Congruential Random Generator Trace (Section Problem)",
    "description": "Calculate states for congruential generator R_{i+1} = (a * R_i + c) mod T. Parameters: a=1, c=4, T=5, seed R_0=2. Normalized output U_i = R_i / T.",
    "hint": "LCG recurrence calculates remainder of division by T. R_0=2, R_1=(1*2+4) mod 5 = 1, U_1=1/5=0.2.",
    "columns": [
      { "key": "x_i", "label": "State R_i" },
      { "key": "term", "label": "(a*R_i + c)" },
      { "key": "x_next", "label": "Next R_{i+1}" },
      { "key": "u_next", "label": "Normalized U_{i+1}" }
    ],
    "rows": [
